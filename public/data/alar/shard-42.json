[{"id":156593,"word":"ಱ","pronunciation":"ṛa","origin":"","note":"","definitions":[{"meaning":"(gen. pronounced with the vowel 'ಅ') the forty ninth letter of Kannaḍa alphabet and the thirty fifth consonant.","type":"noun"}]},{"id":156594,"word":"ಱಂಚಿಕೆ","pronunciation":"ṛancike","origin":"","note":"","definitions":[{"meaning":"a seat, esp. with a canopy and railing, for riding on the back of an elephant; a howdah.","type":"noun"}]},{"id":156595,"word":"ಱಂಚಿಕೆ","pronunciation":"ṛancike","origin":"","note":"","definitions":[{"meaning":"a kind of plant.","type":"noun"}]},{"id":156596,"word":"ಱಂಚಿಗೆ","pronunciation":"ṛancige","origin":"","note":"","definitions":[{"meaning":"= ಱಂಚಿಕೆ1.","type":"noun"}]},{"id":156597,"word":"ಱಂಚೆ","pronunciation":"ṛance","origin":"","note":"","definitions":[{"meaning":"an armour to guard the sides of elephants or horses in the battlefield.","type":"noun"}]},{"id":156598,"word":"ಱಂಚೆಯ","pronunciation":"ṛanceya","origin":"","note":"","definitions":[{"meaning":"= ಱಂಚೆ.","type":"noun"}]},{"id":156599,"word":"ಱಂಜಿಕೆ","pronunciation":"ṛanjike","origin":"","note":"","definitions":[{"meaning":"= ಱಂಚಿಕೆ1.","type":"noun"}]},{"id":156600,"word":"ಱಂಜಿಕೆ","pronunciation":"ṛanjike","origin":"","note":"","definitions":[{"meaning":"= ಱಂಚಿಕೆ2.","type":"noun"}]},{"id":156601,"word":"ಱಂಜಿಗೆ","pronunciation":"ṛanjige","origin":"","note":"","definitions":[{"meaning":"= ಱಂಚಿಕೆ2.","type":"noun"}]},{"id":156602,"word":"ಱಕಾರ","pronunciation":"ṛkāra","origin":"","note":"","definitions":[{"meaning":"the letter or the sound of 'ಱ' (usu. pronounced with the vowel 'ಅ'.","type":"noun"}]},{"id":156603,"word":"ಱಕ್ಕೆ","pronunciation":"ṛakke","origin":"","note":"","definitions":[{"meaning":"either of the two feathered forelimbs of a bird, for flight, balance in running, for swimming, etc.; a wing.","type":"noun"},{"meaning":"(dial.) that part of the human body between shoulder and elbow; the arm.","type":"noun"}]},{"id":156604,"word":"ಱಚ್ಚೆ","pronunciation":"ṛacce","origin":"","note":"","definitions":[{"meaning":"wet, soggy earth or something resembling this; slush; mire.","type":"noun"},{"meaning":"the quality of being resentfully envious; envy; jealosy.","type":"noun"},{"meaning":"the act of blaming; accusation; condemnation; censure.","type":"noun"},{"meaning":"an act, condition, thing or person causing trouble, annoyance or inconvenience.","type":"noun"},{"meaning":"the quality of being unyielding, obstinate; stubbornness; obstinacy.","type":"noun"},{"meaning":"the act of revenging; vengeance; revenge.","type":"noun"},{"meaning":"strong, stern or fierce anger; deeply resentful indignation; wrath; ire.","type":"noun"}]},{"id":156605,"word":"ಱಚ್ಚೆಗೆಯ್","pronunciation":"ṛaccegey","origin":"","note":"","definitions":[{"meaning":"to pursue something adamantly without heeding to any advice against it (as a child).","type":"verb"}]},{"id":156606,"word":"ಱಚ್ಚೆವಾತು","pronunciation":"ṛaccevātu","origin":"","note":"","definitions":[{"meaning":"a charge of wrongdoing; imputation of guilt or blame; accusation.","type":"noun"}]},{"id":156607,"word":"ಱಟ್ಟಡಿ","pronunciation":"ṛaṭṭaḍi","origin":"","note":"","definitions":[{"meaning":"the verbal condemnation; harshly or coarsely insulting language; a scolding; abuse.","type":"noun"}]},{"id":156608,"word":"ಱಟ್ಟಡಿಕಾತಿ","pronunciation":"ṛaṭṭaḍikāti","origin":"","note":"","definitions":[{"meaning":"a woman who uses harsh words or coarse language.","type":"noun"}]},{"id":156609,"word":"ಱಟ್ಟಡಿಕಾರ್ತಿ","pronunciation":"ṛaṭṭaḍikārti","origin":"","note":"","definitions":[{"meaning":"= ಱಟ್ಟಡಿಕಾತಿ.","type":"noun"}]},{"id":156610,"word":"ಱಟ್ಟಡಿಕಾಱ","pronunciation":"ṛaṭṭaḍikāṛa","origin":"","note":"","definitions":[{"meaning":"a man who uses harsh words or coarse language.","type":"noun"}]},{"id":156611,"word":"ಱಟ್ಟಡಿತನ","pronunciation":"ṛaṭṭaḍitana","origin":"","note":"","definitions":[{"meaning":"the quality of being harsh, hard, brave or adamant.","type":"noun"}]},{"id":156612,"word":"ಱಟ್ಟೆ","pronunciation":