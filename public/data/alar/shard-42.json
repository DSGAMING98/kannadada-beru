:"","definitions":[{"meaning":"without having a reason or purpose.","type":"adverb"}]},{"id":156632,"word":"ಱುಂಚೆ","pronunciation":"ṛunce","origin":"","note":"","definitions":[{"meaning":"a sort of brazen drum.","type":"noun"}]},{"id":156633,"word":"ಱುಂಜೆ","pronunciation":"ṛunje","origin":"","note":"","definitions":[{"meaning":"= ಱುಂಚೆ.","type":"noun"}]},{"id":156634,"word":"ಱೆಂಕೆ","pronunciation":"ṛenke","origin":"","note":"","definitions":[{"meaning":"= ಱಕ್ಕೆ.","type":"noun"}]},{"id":156635,"word":"ಱೆಂಚೆ","pronunciation":"ṛence","origin":"","note":"","definitions":[{"meaning":"= ಱಂಚೆ.","type":"noun"}]},{"id":156636,"word":"ಱೆಂಚೆಯ","pronunciation":"ṛenceya","origin":"","note":"","definitions":[{"meaning":"= ಱಂಚೆ.","type":"noun"}]},{"id":156637,"word":"ಱೆಕ್ಕೆ","pronunciation":"ṛekke","origin":"","note":"","definitions":[{"meaning":"= ಱಕ್ಕೆ.","type":"noun"}]},{"id":156638,"word":"ಱೆಪ್ಪು","pronunciation":"ṛeppu","origin":"","note":"","definitions":[{"meaning":"to hit or strike repeatedly; to pound; to beat.","type":"verb"},{"meaning":"to throw or fling something at.","type":"verb"}]},{"id":156639,"word":"ಱೆಪ್ಪೆ","pronunciation":"ṛeppe","origin":"","note":"","definitions":[{"meaning":"the movable lid of skin that serves to cover and uncover the front of the eyeball; the eyelid.","type":"noun"}]},{"id":156640,"word":"ಱೊಂಕಿಡು","pronunciation":"ṛonkiḍu","origin":"","note":"","definitions":[{"meaning":"= ಱೌಂಕಿಡು.","type":"verb"}]},{"id":156641,"word":"ಱೊಂಕು","pronunciation":"ṛonku","origin":"","note":"","definitions":[{"meaning":"= ಱೌಂಕು.","type":"noun"}]},{"id":156642,"word":"ಱೊಂಪೆ","pronunciation":"ṛompe","origin":"","note":"","definitions":[{"meaning":"wet, soft earth or earthy matter, as on the ground after rain, at the bottom of a pond or along the banks of a river; mire.","type":"noun"},{"meaning":"offensive or disgusting dirt or refuse; foul matter; filth.","type":"noun"}]},{"id":156643,"word":"ಱೊಜ್ಜು","pronunciation":"ṛojju","origin":"","note":"","definitions":[{"m